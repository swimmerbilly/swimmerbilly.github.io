# Harvest API credentials
# Create a Personal Access Token at https://id.getharvest.com/developers
HARVEST_ACCESS_TOKEN=your_personal_access_token_here
HARVEST_ACCOUNT_ID=your_account_id_here
HARVEST_USER_AGENT=Life Organizer (you@example.com)

# Work email — Microsoft Outlook / Microsoft 365
WORK_EMAIL_IMAP_HOST=outlook.office365.com
WORK_EMAIL_IMAP_PORT=993
WORK_EMAIL_IMAP_USER=you@yourcompany.com
WORK_EMAIL_IMAP_PASSWORD=your_outlook_app_password_here
WORK_EMAIL_IMAP_FOLDER=INBOX

# Personal email — Gmail
PERSONAL_EMAIL_IMAP_HOST=imap.gmail.com
PERSONAL_EMAIL_IMAP_PORT=993
PERSONAL_EMAIL_IMAP_USER=you@gmail.com
PERSONAL_EMAIL_IMAP_PASSWORD=your_gmail_app_password_here
PERSONAL_EMAIL_IMAP_FOLDER=INBOX

# Grasshopper phone service (no public API — syncs via email + optional webhook)
# By default Grasshopper uses your WORK Outlook inbox above.
# Point Grasshopper voicemail notifications to your company Outlook address.
# Override only if Grasshopper sends to a different inbox:
# GRASSHOPPER_IMAP_HOST=outlook.office365.com
# GRASSHOPPER_IMAP_USER=you@yourcompany.com
# GRASSHOPPER_IMAP_PASSWORD=your_outlook_app_password_here

# Optional: secret for POST /api/grasshopper/webhook (for Zapier or custom automations)
GRASSHOPPER_WEBHOOK_SECRET=choose_a_long_random_secret

# AI Secretary Assistant (OpenAI-compatible API)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_NAME=Alex
