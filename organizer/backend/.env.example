# Harvest API credentials
# Create a Personal Access Token at https://id.getharvest.com/developers
HARVEST_ACCESS_TOKEN=your_personal_access_token_here
HARVEST_ACCOUNT_ID=your_account_id_here
HARVEST_USER_AGENT=Life Organizer (you@example.com)

# Grasshopper phone service (no public API — syncs via email + optional webhook)
# Point Grasshopper voicemail notifications to this inbox in Grasshopper settings.
GRASSHOPPER_IMAP_HOST=imap.gmail.com
GRASSHOPPER_IMAP_PORT=993
GRASSHOPPER_IMAP_USER=you@example.com
GRASSHOPPER_IMAP_PASSWORD=your_app_password_here
GRASSHOPPER_IMAP_FOLDER=INBOX

# Optional: secret for POST /api/grasshopper/webhook (for Zapier or custom automations)
GRASSHOPPER_WEBHOOK_SECRET=choose_a_long_random_secret
